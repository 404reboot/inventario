<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controlador.LoginController"
      spacing="15" alignment="CENTER"
      prefWidth="400" prefHeight="300"
      style="-fx-background-color: #f0f0f0; -fx-padding: 20;">

    <children>
        <Label text="Sistema de Inventario"
               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

        <Label text="Iniciar Sesión"
               style="-fx-font-size: 18px; -fx-text-fill: #34495e;"/>

        <VBox spacing="10" alignment="CENTER">
            <TextField fx:id="usernameField" promptText="Usuario"
                       prefWidth="250" style="-fx-padding: 10;"/>

            <PasswordField fx:id="passwordField" promptText="Contraseña"
                           prefWidth="250" style="-fx-padding: 10;"/>

            <Button text="Iniciar Sesión"
                    onAction="#handleLogin"
                    style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 30;"/>
        </VBox>
    </children>
</VBox>