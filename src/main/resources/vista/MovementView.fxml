<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controlador.MovementController"
      spacing="10" style="-fx-padding: 20; -fx-background-color: white;">

    <children>
        <Label text="Movimientos de Inventario"
               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

        <GridPane hgap="20" vgap="10" style="-fx-padding: 10; -fx-background-color: #f8f9fa; -fx-border-color: #dee2e6; -fx-border-radius: 5;">
            <children>
                <Label text="Total Movimientos:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
                <Label fx:id="totalMovimientosLabel" text="0" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label text="Entradas:" GridPane.columnIndex="2" GridPane.rowIndex="0" style="-fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
                <Label fx:id="totalEntradasLabel" text="0" GridPane.columnIndex="3" GridPane.rowIndex="0" style="-fx-text-fill: #27ae60;"/>

                <Label text="Salidas:" GridPane.columnIndex="4" GridPane.rowIndex="0" style="-fx-font-weight: bold; -fx-text-fill: #e74c3c;"/>
                <Label fx:id="totalSalidasLabel" text="0" GridPane.columnIndex="5" GridPane.rowIndex="0" style="-fx-text-fill: #e74c3c;"/>

                <Label text="Valor Entradas:" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-weight: bold;"/>
                <Label fx:id="valorEntradasLabel" text="0.00" GridPane.columnIndex="1" GridPane.rowIndex="1" style="-fx-text-fill: #27ae60;"/>

                <Label text="Valor Salidas:" GridPane.columnIndex="2" GridPane.rowIndex="1" style="-fx-font-weight: bold;"/>
                <Label fx:id="valorSalidasLabel" text="0.00" GridPane.columnIndex="3" GridPane.rowIndex="1" style="-fx-text-fill: #e74c3c;"/>
            </children>
        </GridPane>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <children>
                <Label text="Filtros:" style="-fx-font-weight: bold;"/>
                <ComboBox fx:id="filterTypeCombo" prefWidth="100"/>
                <DatePicker fx:id="startDatePicker" prefWidth="120"/>
                <DatePicker fx:id="endDatePicker" prefWidth="120"/>
                <Button text="Filtrar" onAction="#handleFilter"
                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 5 15;"/>
                <Button text="Limpiar" onAction="#handleClearFilter"
                        style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 5 15;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnNuevaEntrada" text="➕ Entrada"
                        onAction="#handleNuevaEntrada"
                        style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 16;"/>
                <Button fx:id="btnNuevaSalida" text="➖ Salida"
                        onAction="#handleNuevaSalida"
                        style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 16;"/>
                <Button fx:id="btnActualizar" text="🔄 Actualizar"
                        onAction="#handleActualizar"
                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 16;"/>
            </children>
        </HBox>

        <TableView fx:id="movementTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
                <TableColumn fx:id="colTipo" text="Tipo" prefWidth="80"/>
                <TableColumn fx:id="colProducto" text="Producto" prefWidth="200"/>
                <TableColumn fx:id="colCantidad" text="Cantidad" prefWidth="80"/>
                <TableColumn fx:id="colPrecio" text="Precio Unit." prefWidth="100"/>
                <TableColumn fx:id="colSubtotal" text="Subtotal" prefWidth="100"/>
                <TableColumn fx:id="colMotivo" text="Motivo" prefWidth="150"/>
                <TableColumn fx:id="colUsuario" text="Usuario" prefWidth="120"/>
                <TableColumn fx:id="colFecha" text="Fecha" prefWidth="150"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </children>
</VBox>